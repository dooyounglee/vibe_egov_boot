<?xml version="1.0" encoding="UTF-8"?>
<!-- 표준프레임워크 기본 로깅(Log4j2) 설정 -->
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1.} - %msg%n</Property>
        <Property name="logDir">${sys:LOG_DIR:-logs}</Property>
    </Properties>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}" charset="UTF-8"/>
        </Console>
        <RollingFile name="file" fileName="${logDir}/portal.log"
                     filePattern="${logDir}/portal-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <SpringProfile name="local">
            <Root level="info">
                <AppenderRef ref="console"/>
            </Root>
        </SpringProfile>
        <SpringProfile name="!local">
            <Root level="info">
                <AppenderRef ref="console"/>
                <AppenderRef ref="file"/>
            </Root>
        </SpringProfile>
    </Loggers>
</Configuration>
